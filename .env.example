# QQ 邮箱
MAIL_ADDRESS=your_name@qq.com
MAIL_AUTH_CODE=your_imap_smtp_auth_code
IMAP_HOST=imap.qq.com
IMAP_PORT=993
SMTP_HOST=smtp.qq.com
SMTP_PORT=465

# 拉取与轮询
MAIL_FETCH_LIMIT=10
POLL_INTERVAL_SECONDS=120

# LLM：至少配置一个 Key；
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER_ORDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_MODEL=deepseek-chat
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
ROUTER_LLM_MIN_CONFIDENCE=0.7
MAX_REWRITE_ROUNDS=5
MAX_EMAIL_BODY_CHARS=8000

# 应用（一般无需修改）
DATABASE_PATH=data/mail.db
HOST=127.0.0.1
PORT=8000
DISPLAY_TIMEZONE=Asia/Shanghai
DEMO_MODE=false
